&Тест
Процедура КогдаПустой_ТогдаМетодИначеВызватьИсключениеВыбрасываетИсключение() Экспорт
	
	// Кокгда
	Объект = Неопределено;
	Опциональный = Новый Опциональный(Объект, Истина);
	
	ИнформацияОбОшибке = Новый ИнформацияОбОшибке("Мое исключение", Неопределено);
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(ИнформацияОбОшибке);

	// Тогда
	Ожидаем.Что(Опциональный).Метод("ИначеВызватьИсключение", ПараметрыМетода).ВыбрасываетИсключение("Мое исключение");

КонецПроцедуры

&Тест
Процедура ПустойОпциональный() Экспорт

	// Дано

	Опциональный = Опциональные.Пустой();
	ВторойОпциональный = Опциональные.Пустой();

	// Когда

	Значение = Опциональный.Пустой();

	// Тогда

	Ожидаем.Что(Значение).ЭтоИстина();
	Ожидаем.Что(Опциональный).Равно(ВторойОпциональный);

КонецПроцедуры

&Тест
Процедура ОбработатьИспользуетКонтекстСтруктуру() Экспорт

	Опциональный = Новый Опциональный(3);
	Контекст = Новый Структура("Смещение", 2);

	Результат = Опциональный.Обработать("Значение -> Значение + Смещение", Контекст);

	Ожидаем.Что(Результат.Получить()).Равно(5);
	Ожидаем.Что(Опциональный.Получить()).Равно(3);

КонецПроцедуры

&Тест
Процедура РазвернутьИспользуетКонтекстСтруктуру() Экспорт

	Опциональный = Новый Опциональный(3);
	Контекст = Новый Структура("Смещение", 2);

	Результат = Опциональный.Развернуть("Значение -> Новый Опциональный(Значение + Смещение)", Контекст);

	Ожидаем.Что(Результат.Получить()).Равно(5);

КонецПроцедуры

&Тест
Процедура ФильтроватьИспользуетКонтекстСтруктуру() Экспорт

	Опциональный = Новый Опциональный(3);
	Предикат = "Значение -> Значение > Порог";

	Принятый = Опциональный.Фильтровать(Предикат, Новый Структура("Порог", 2));
	Отклоненный = Опциональный.Фильтровать(Предикат, Новый Структура("Порог", 4));

	Ожидаем.Что(Принятый).Равно(Опциональный);
	Ожидаем.Что(Отклоненный.Пустой()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЕслиСодержитЗначениеИспользуетКонтекстСтруктуру() Экспорт

	Опциональный = Новый Опциональный(3);
	Результаты = Новый Массив;
	Контекст = Новый Структура("Результаты, Смещение", Результаты, 2);

	Опциональный.ЕслиСодержитЗначение("Значение -> Результаты.Добавить(Значение + Смещение)", Контекст);

	Ожидаем.Что(Результаты.Количество()).Равно(1);
	Ожидаем.Что(Результаты[0]).Равно(5);

КонецПроцедуры

&Тест
Процедура ЕслиСодержитЗначениеИначеИспользуетКонтекстВыбраннойВетки() Экспорт

	Опциональный = Новый Опциональный(3);
	Результаты = Новый Массив;
	Контекст = Новый Структура("Результаты, Смещение", Результаты, 2);
	КонтекстИначе = Новый Структура("Результаты, Смещение", Результаты, 10);
	Обработка = "Значение -> Результаты.Добавить(Значение + Смещение)";
	ОбработкаИначе = "() -> Результаты.Добавить(Смещение)";

	Опциональный.ЕслиСодержитЗначениеИначе(Обработка, ОбработкаИначе, Контекст, КонтекстИначе);
	Опциональные.Пустой().ЕслиСодержитЗначениеИначе(Обработка, ОбработкаИначе, Контекст, КонтекстИначе);

	Ожидаем.Что(Результаты.Количество()).Равно(2);
	Ожидаем.Что(Результаты[0]).Равно(5);
	Ожидаем.Что(Результаты[1]).Равно(10);

КонецПроцедуры

&Тест
Процедура ИлиИспользуетКонтекстСтруктуру() Экспорт

	Контекст = Новый Структура("ЗначениеИначе", 5);

	Результат = Опциональные.Пустой().Или_("() -> ЗначениеИначе", Контекст);

	Ожидаем.Что(Результат.Получить()).Равно(5);

КонецПроцедуры

&Тест
Процедура ИначеПолучитьИспользуетКонтекстСтруктуру() Экспорт

	Контекст = Новый Структура("ЗначениеИначе", 5);

	Результат = Опциональные.Пустой().ИначеПолучить("() -> ЗначениеИначе", Контекст);

	Ожидаем.Что(Результат).Равно(5);

КонецПроцедуры

&Тест
Процедура КонтекстПоддерживаетФиксированнуюСтруктуру() Экспорт

	Опциональный = Новый Опциональный(3);
	Результаты = Новый Массив;
	Контекст = Новый ФиксированнаяСтруктура(Новый Структура("Смещение, Результаты", 2, Результаты));

	Результат = Опциональный.Обработать("Значение -> Значение + Смещение", Контекст);
	Опциональный.ЕслиСодержитЗначение("Значение -> Результаты.Добавить(Значение + Смещение)", Контекст);
	ЗначениеИначе = Опциональные.Пустой().ИначеПолучить("() -> Смещение", Контекст);

	Ожидаем.Что(Результат.Получить()).Равно(5);
	Ожидаем.Что(Результаты[0]).Равно(5);
	Ожидаем.Что(ЗначениеИначе).Равно(2);

КонецПроцедуры

&Тест
Процедура КонтекстОбъектОткрываетПриватныеПоляИПубличныеМетоды() Экспорт

	Опциональный = Новый Опциональный(3);
	СмещениеКонтекста = 5;

	Результат = Опциональный.Обработать("Значение -> ДействиеОбработать(Значение) + СмещениеКонтекста", ЭтотОбъект);
	ЗначениеИначе = Опциональные.Пустой().ИначеПолучить("() -> СмещениеКонтекста", ЭтотОбъект);

	Ожидаем.Что(Результат.Получить()).Равно(9);
	Ожидаем.Что(ЗначениеИначе).Равно(5);

КонецПроцедуры

&Тест
Процедура КонтекстОбъектПоддерживаетПроцедуры() Экспорт

	Опциональный = Новый Опциональный(3);
	СмещениеКонтекста = 5;

	Опциональный.ЕслиСодержитЗначение("Значение -> ДействиеЕслиСодержитЗначение(Значение + СмещениеКонтекста)", ЭтотОбъект);
	Ожидаем.Что(ТестМодуль.Параметр).Равно(9);

	Опциональные.Пустой().ЕслиСодержитЗначениеИначе(
		"Некорректная лямбда", "() -> ДействиеЕслиСодержитЗначение(СмещениеКонтекста)", , ЭтотОбъект);
	Ожидаем.Что(ТестМодуль.Параметр).Равно(6);

КонецПроцедуры

&Тест
Процедура КонтекстИгнорируетсяДляДействийФункций() Экспорт

	Опциональный = Новый Опциональный(1);
	Контекст = Новый Структура("Значение", 100);

	Обработанный = Опциональный.Обработать(Новый Действие(ЭтотОбъект, "ДействиеОбработать"), Контекст);
	Развернутый = Опциональный.Развернуть(Новый Действие(ЭтотОбъект, "ДействиеРазвертки"), Контекст);
	Отфильтрованный = Опциональный.Фильтровать(Новый Действие(ЭтотОбъект, "ДействиеФильтрации"), Контекст);
	Альтернативный = Опциональные.Пустой().Или_(Новый Действие(ЭтотОбъект, "ДействиеИли"), Контекст);
	ЗначениеИначе = Опциональные.Пустой().ИначеПолучить(Новый Действие(ЭтотОбъект, "ДействиеИли"), Контекст);

	Ожидаем.Что(Обработанный.Получить()).Равно(2);
	Ожидаем.Что(Развернутый.Получить()).Равно(2);
	Ожидаем.Что(Отфильтрованный).Равно(Опциональный);
	Ожидаем.Что(Альтернативный.Получить()).Равно(2);
	Ожидаем.Что(ЗначениеИначе).Равно(2);

КонецПроцедуры

&Тест
Процедура КонтекстИгнорируетсяДляДействийПроцедур() Экспорт

	Опциональный = Новый Опциональный(1);
	Контекст = Новый Структура("Значение", 100);
	Обработка = Новый Действие(ЭтотОбъект, "ДействиеЕслиСодержитЗначение");
	ОбработкаИначе = Новый Действие(ЭтотОбъект, "ДействиеЕслиСодержитЗначениеИначе");

	Опциональный.ЕслиСодержитЗначение(Обработка, Контекст);
	Ожидаем.Что(ТестМодуль.Параметр).Равно(2);

	Опциональный.ЕслиСодержитЗначениеИначе(Обработка, ОбработкаИначе, Контекст, Контекст);
	Ожидаем.Что(ТестМодуль.Параметр).Равно(2);

	Опциональные.Пустой().ЕслиСодержитЗначениеИначе(Обработка, ОбработкаИначе, Контекст, Контекст);
	Ожидаем.Что(ТестМодуль.Параметр).Равно(3);

КонецПроцедуры

&Тест
Процедура ПустойОпциональныйНеКомпилируетОбработчикиСКонтекстом() Экспорт

	Опциональный = Опциональные.Пустой();
	Контекст = Новый Структура("Значение", 100);
	Обработка = "Некорректная лямбда";

	Обработанный = Опциональный.Обработать(Обработка, Контекст);
	Развернутый = Опциональный.Развернуть(Обработка, Контекст);
	Отфильтрованный = Опциональный.Фильтровать(Обработка, Контекст);
	Опциональный.ЕслиСодержитЗначение(Обработка, Контекст);

	Ожидаем.Что(Обработанный).Равно(Опциональный);
	Ожидаем.Что(Развернутый.Пустой()).ЭтоИстина();
	Ожидаем.Что(Отфильтрованный).Равно(Опциональный);

КонецПроцедуры

&Тест
Процедура ЗаполненныйОпциональныйНеКомпилируетАльтернативныеОбработчикиСКонтекстом() Экспорт

	Опциональный = Новый Опциональный(3);
	Контекст = Новый Структура("Значение", 100);
	ОбработкаИначе = "Некорректная лямбда";

	Альтернативный = Опциональный.Или_(ОбработкаИначе, Контекст);
	ЗначениеИначе = Опциональный.ИначеПолучить(ОбработкаИначе, Контекст);
	Опциональный.ЕслиСодержитЗначениеИначе("Значение -> ТестМодуль.Параметр = Значение",
		ОбработкаИначе, , Контекст);

	Ожидаем.Что(Альтернативный).Равно(Опциональный);
	Ожидаем.Что(ЗначениеИначе).Равно(3);
	Ожидаем.Что(ТестМодуль.Параметр).Равно(3);

КонецПроцедуры

Процедура ДействиеЕслиСодержитЗначение(Значение) Экспорт
	ТестМодуль.Параметр = Значение + 1;
КонецПроцедуры

Процедура ДействиеЕслиСодержитЗначениеИначе() Экспорт
	ТестМодуль.Параметр = 3;
КонецПроцедуры

Функция ДействиеОбработать(Значение) Экспорт
	Возврат Значение + 1;
КонецФункции

Функция ДействиеФильтрации(Значение) Экспорт
	Возврат Значение = 1;
КонецФункции

Функция ДействиеРазвертки(Значение) Экспорт
	Возврат Новый Опциональный(Значение + 1);
КонецФункции

Функция ДействиеИли() Экспорт
	Возврат 2;
КонецФункции
