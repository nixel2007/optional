#Использовать ".."
#Использовать asserts

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ЕслиСодержитЗначениеНеМеняетХранимоеЗначение(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2",
		Новый Действие(ЭтотОбъект, "ПереприсвоитьЗначение"));

	Опциональный.ЕслиСодержитЗначение(Обработчик);

	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ЕслиСодержитЗначениеИначеНеМеняетХранимоеЗначение(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2",
		Новый Действие(ЭтотОбъект, "ПереприсвоитьЗначение"));

	Опциональный.ЕслиСодержитЗначениеИначе(Обработчик, "Некорректная лямбда");

	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ОбработатьНеМеняетИсходныйОпциональный(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2; Возврат Значение + 1",
		Новый Действие(ЭтотОбъект, "ОбработатьСПереприсваиванием"));

	Результат = Опциональный.Обработать(Обработчик);

	Ожидаем.Что(Результат.Получить()).Равно(3);
	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура РазвернутьНеМеняетИсходныйОпциональный(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2; Возврат Новый Опциональный(Значение + 1)",
		Новый Действие(ЭтотОбъект, "РазвернутьСПереприсваиванием"));

	Результат = Опциональный.Развернуть(Обработчик);

	Ожидаем.Что(Результат.Получить()).Равно(3);
	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ФильтроватьНеМеняетХранимоеЗначение(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2; Возврат Истина",
		Новый Действие(ЭтотОбъект, "ФильтроватьСПереприсваиванием"));

	Результат = Опциональный.Фильтровать(Обработчик);

	Ожидаем.Что(Результат).Равно(Опциональный);
	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ИсключениеОбработчикаНеМеняетХранимоеЗначение(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2; ВызватьИсключение ""Ошибка обработчика""",
		Новый Действие(ЭтотОбъект, "ПереприсвоитьИВызватьИсключение"));
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Обработчик);

	Ожидаем.Что(Опциональный).Метод("ЕслиСодержитЗначение", ПараметрыМетода)
		.ВыбрасываетИсключение("Ошибка обработчика");

	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

