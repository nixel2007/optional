&ИсточникЗначение(Ложь)
Процедура ПроцессорКоллекцийНеМеняетХранимоеЗначение(КакЛямбда) Экспорт

	Опциональный = Новый Опциональный(1);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2",
		Новый Действие(ЭтотОбъект, "ПереприсвоитьЗначение"));

	Опциональный.ПроцессорКоллекций().ДляКаждого(Обработчик);

	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ПереприсваиваниеНеЗаменяетСсылкуНаХранимыйОбъект(КакЛямбда) Экспорт

	ИсходныйОбъект = Новый Структура("Значение", 1);
	Опциональный = Новый Опциональный(ИсходныйОбъект);
	Обработчик = ?(КакЛямбда, "Значение -> Значение = 2",
		Новый Действие(ЭтотОбъект, "ПереприсвоитьЗначение"));

	Опциональный.ЕслиСодержитЗначение(Обработчик);

	Ожидаем.Что(Опциональный.Получить()).Равно(ИсходныйОбъект);

КонецПроцедуры

&Тест
Процедура КонструкторНеСвязываетПолеСИсходнойПеременной() Экспорт

	ИсходноеЗначение = 1;
	Опциональный = Новый Опциональный(ИсходноеЗначение);

	ИсходноеЗначение = 2;

	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

&Тест
Процедура ПолучениеЗначенияНеПередаетСсылкуНаПоле() Экспорт

	Опциональный = Новый Опциональный(1);

	ПереприсвоитьЗначение(Опциональный.Получить());
	ПереприсвоитьЗначение(Опциональный.Иначе_(0));
	ПереприсвоитьЗначение(Опциональный.ИначеПолучить("Некорректная лямбда"));
	ПереприсвоитьЗначение(Опциональный.ИначеВызватьИсключение(Новый ИнформацияОбОшибке("Ошибка", Неопределено)));

	Ожидаем.Что(Опциональный.Получить()).Равно(1);

КонецПроцедуры

Процедура ПереприсвоитьЗначение(Значение) Экспорт
	Значение = 2;
КонецПроцедуры

Процедура ПереприсвоитьИВызватьИсключение(Значение) Экспорт
	Значение = 2;
	ВызватьИсключение "Ошибка обработчика";
КонецПроцедуры

Функция ОбработатьСПереприсваиванием(Значение) Экспорт
	Значение = 2;
	Возврат Значение + 1;
КонецФункции

Функция РазвернутьСПереприсваиванием(Значение) Экспорт
	Значение = 2;
	Возврат Новый Опциональный(Значение + 1);
КонецФункции

Функция ФильтроватьСПереприсваиванием(Значение) Экспорт
	Значение = 2;
	Возврат Истина;
КонецФункции
